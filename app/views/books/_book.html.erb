<% cache book do %>
  <figure class="library__book <%= "theme--#{book&.theme}" unless book.cover.attached? %>">
    <div class="flex flex-column gap-half">
      <div class="flex-inline position-relative center">
        <% if book.cover.attached? %>
          <%= image_tag book.cover, alt: "Book cover", class: "book__cover" %>
        <% else %>
          <span class="book__cover-wrapper">
            <%= book_cover_art(seed: book.cover_seed, theme: book.theme, cover_style: book.cover_style, class: "book__cover margin-block-none center") %>
            <span class="book__cover-copy book__cover-copy--preview" aria-hidden="true">
              <span class="book__title book__cover-title book__cover-title--preview overflow-line-clamp txt-align-start txt-tight-lines" style="--lines: 4"><%= book.title %></span>
              <% if book.subtitle.present? %>
                <span class="book__cover-subtitle book__cover-subtitle--preview overflow-line-clamp txt-align-start" style="--lines: 2"><%= book.subtitle %></span>
              <% end %>
              <% if book.author.present? %>
                <span class="book__cover-author book__cover-author--preview overflow-line-clamp txt-align-start" style="--lines: 2"><%= book.author %></span>
              <% end %>
            </span>
          </span>
        <% end %>
        <%= turbo_frame_tag dom_id(book, :bookmark), src: book_bookmark_path(book), target: "_top" %>
      </div>
      <% if book.cover.attached? %>
        <h2 class="margin-none flex flex-column txt-normal txt-tight-lines txt-medium--responsive">
          <strong><%= book.title %></strong>
          <span class="overflow-line-clamp"><%= book.author %></span>
        </h2>
      <% else %>
        <h2 class="for-screen-reader">
          <%= book.title %> <%= book.author %>
        </h2>
      <% end %>
    </div>
  </figure>
<% end %>
